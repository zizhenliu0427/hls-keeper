{
  "manifest_version": 3,
  "name": "Web Keeper",
  "version": "0.1.3",
  "description": "Capture authorised HLS requests and send them to the local Web Keeper service.",
  "permissions": ["webRequest", "alarms", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:17888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Web Keeper",
    "default_popup": "popup.html"
  }
}
