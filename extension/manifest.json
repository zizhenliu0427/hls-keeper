{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.3.9",
  "description": "__MSG_appDescription__",
  "default_locale": "zh_CN",
  "incognito": "split",
  "key": "",
  "permissions": ["webRequest", "storage", "activeTab", "scripting", "unlimitedStorage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Web Keeper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  }
}
